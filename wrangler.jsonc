{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chiiki-shinki-bairitsu",
  "main": "src/worker.tsx",
  "compatibility_date": "2026-07-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "chiiki-shinki-bairitsu.yhay81.com", "custom_domain": true }],
  "triggers": { "crons": ["31 22 * * *"] },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "chiiki-shinki-bairitsu",
      "database_id": "491680c1-c8fb-4c17-9f6d-170072b324dc",
      "migrations_dir": "migrations",
    },
  ],
  "assets": { "directory": "./public", "binding": "ASSETS" },
}
